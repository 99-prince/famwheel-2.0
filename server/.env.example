# FAM WHEEL Server – Environment Variables
# Copy this file to .env and fill in your values

# ── SERVER ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── DATABASE ─────────────────────────────────────
# Option A: PostgreSQL (Production recommended)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/famwheel_db"

# Option B: SQLite (Easy local dev – no setup needed!)
# DATABASE_URL="file:./famwheel.db"

# ── JWT ──────────────────────────────────────────
JWT_SECRET=famwheel_super_secret_jwt_key_change_in_production_2025
JWT_EXPIRES_IN=7d

# ── CLOUDINARY (for crop images) ─────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CLIENT URL (for CORS) ────────────────────────
CLIENT_URL=http://localhost:5173
